# Append-only logs written on both machines: when "⇅ Đồng bộ" (git pull --rebase) meets edits from the
# other machine in the same place, keep both sides' lines instead of stopping with a conflict.
trainer/bank/issues.md merge=union
trainer/bank/ratings.md merge=union
trainer/coach/qa/*.md merge=union
trainer/bank/verify.md merge=union
# FSRS optimizer output: one JSON object per line, the newest `optimizedAt` wins — keep both machines' lines
trainer/results/fsrs-params.json merge=union

# Launchers need their native line endings whatever core.autocrlf says.
trainer/*.bat text eol=crlf
trainer/*.sh text eol=lf
trainer/*.command text eol=lf
