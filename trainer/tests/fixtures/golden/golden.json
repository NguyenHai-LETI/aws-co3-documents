     "key": "A",
     "text": "Enable automated backups with a 35-day retention period"
    },
    {
     "key": "B",
     "text": "Deploy the DB instance as a Multi-AZ deployment"
    },
    {
     "key": "C",
     "text": "Increase the instance size before every reporting window"
    },
    {
     "key": "D",
     "text": "Add read replicas and point the reporting tool at the reader endpoint"
    },
    {
     "key": "E",
     "text": "Turn on Performance Insights for the database"
    }
   ],
   "answer": [
    "B",
    "D"
   ],
   "explanation": "Multi-AZ provides automatic failover; read replicas absorb the reporting reads.",
