  "golden-checkbox-01": {
   "id": "golden-checkbox-01",
   "pack": "golden-edge-cases",
   "stem": "A company keeps **monthly** reports in Amazon S3. Reports are read often for 30 days and almost never after that,\nbut they must stay available within milliseconds for audits. Which storage approach is the MOST cost-effective?",
   "options": [
    {
     "key": "A",
     "text": "Keep every report in S3 Standard and rely on S3 Intelligent-Tiering monitoring fees to stay low over time"
    },
    {
     "key": "B",
     "text": "Add a lifecycle rule that transitions objects to S3 Standard-Infrequent Access 30 days after creation"
    },
    {
     "key": "C",
     "text": "Move the reports to S3 Glacier Deep Archive after 30 days and restore them in bulk when an audit starts"
    },
    {
     "key": "D",
     "text": "Copy the reports to an Amazon EBS Cold HDD volume attached to a small EC2 instance"
    }
   ],
   "answer": [
    "B"
   ],
   "explanation": "Standard-IA keeps millisecond access at a lower storage price once access drops.\n- Deep Archive restores take hours.\n- EBS adds an instance to run.",
   "domain": "cost",
   "topic": "storage",
