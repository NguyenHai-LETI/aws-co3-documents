{
  "name": "aws-saa-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Local practice system for AWS SAA-C03: Markdown question bank, Markdown results, AI coach loop.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch-path=server --watch-path=shared server/index.ts",
    "import": "node scripts/import-practice-exams.ts",
    "validate": "node scripts/validate.ts",
    "snapshot": "node scripts/snapshot.ts",
    "coach": "node scripts/coach-run.ts",
    "schedule": "node scripts/schedule.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "vite build",
    "test": "node --test \"tests/*.test.ts\"",
    "rebalance": "node scripts/rebalance-answers.ts",
    "classify-tasks": "node scripts/classify-tasks.ts",
    "apply-patch": "node scripts/apply-patch.ts",
    "enrich-batch": "node scripts/enrich-batch.ts",
    "coverage": "node scripts/coverage.ts",
    "sync": "node scripts/sync.ts",
    "test:e2e": "node --test \"tests/e2e/*.test.ts\"",
    "test:ui": "node tests/ui/smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3"
  }
}
